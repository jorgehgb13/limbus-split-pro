<Project Sdk="WixToolset.Sdk/5.0.2">

  <!--
    Fijado deliberadamente a WiX v5.0.2 (NO v6/v7): ver docs/LICENSING.md,
    sección "WiX Toolset: se fija la versión 5.x". Los comandos exactos
    para instalar el toolset y sus extensiones están en README.md (no se
    repiten aquí porque usan el flag "global" con doble guion, y XML no
    permite dos guiones seguidos dentro de un comentario).
  -->

  <PropertyGroup>
    <OutputType>Package</OutputType>
    <Platforms>x64</Platforms>
    <DefineConstants>PublishDir=$(PublishDir)</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.UI.wixext" Version="5.0.2" />
    <PackageReference Include="WixToolset.Util.wixext" Version="5.0.2" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Product.wxs" />
  </ItemGroup>

</Project>
