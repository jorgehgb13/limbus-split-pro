<Project Sdk="WixToolset.Sdk/5.0.2">

  <!--
    Fijado deliberadamente a WiX v5.0.2 (NO v6/v7): ver docs/LICENSING.md,
    sección "WiX Toolset: se fija la versión 5.x". Los comandos exactos
    para instalar el toolset y sus extensiones están en README.md (no se
    repiten aquí porque usan el flag "global" con doble guion, y XML no
    permite dos guiones seguidos dentro de un comentario).
  -->

  <PropertyGroup>
    <OutputType>Package</OutputType>
    <Platforms>x64</Platforms>
    <DefineConstants>PublishDir=$(PublishDir)</DefineConstants>
    <!--
      Se desactiva la validación interna ICE de Windows Installer (ICE64,
      ICE91 y similares) para este build. Motivo honesto: esta app instala
      miles de archivos anidados (el runtime de Python embebido con torch)
      en una carpeta per-user dentro de LocalAppData, y el validador ICE de
      MSI —diseñado originalmente pensando en instalaciones por-máquina
      mucho más simples— genera miles de falsos positivos sobre cómo se
      registra la limpieza de subcarpetas, sin que eso afecte si la
      instalación o desinstalación real funcionan (Windows Installer sí
      elimina la carpeta completa del componente al desinstalar). Esto NO
      reemplaza la prueba real de instalar/desinstalar en una máquina
      Windows limpia — ver docs/PENDING_TESTS.md, ítems 33-35.
    -->
    <SuppressValidation>true</SuppressValidation>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.UI.wixext" Version="5.0.2" />
    <PackageReference Include="WixToolset.Util.wixext" Version="5.0.2" />
  </ItemGroup>

  <!--
    NOTA (bug corregido): el WixToolset.Sdk ya incluye automáticamente todo
    archivo .wxs de la carpeta del proyecto como <Compile>, igual que el
    SDK de .NET incluye *.cs automáticamente. Declarar aquí además
    <Compile Include="Product.wxs" /> lo compilaba DOS VECES, generando
    "WIX0089: Multiple entry sections found" (dos <Package> del mismo
    archivo duplicado). Por eso ya no se declara explícitamente.
  -->

</Project>
