<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>false</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Deliberadamente SIN <Platforms>x64</Platforms>: forzar el
         concepto de "Platform" de MSBuild a x64 mueve la carpeta de
         salida a bin\x64\Release\... y rompe cualquier comando que
         asuma bin\Release\... (nos pasó justo eso con `dotnet test`).
         La arquitectura real del binario final ya queda fijada por
         RuntimeIdentifiers en `dotnet publish -r win-x64`, así que no
         hace falta la complejidad de "Platform" a nivel de solución. -->
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <RootNamespace>LimbusSplitPro.Core</RootNamespace>
    <AssemblyName>LimbusSplitPro.Core</AssemblyName>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!-- Pinned exact version once resolved on a machine with NuGet access;
         see docs/LICENSING.md for why versions must be pinned, not floating. -->
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
    <PackageReference Include="System.Text.Json" Version="9.0.0" />
  </ItemGroup>

</Project>
